// tlg R5: the engine's buffer fill with a pattern (FUN_02485c00, the SDK's compute copy with wrap): destination[i] = source[i mod pattern], one dispatch.
// Offsets are in dwords from the aligned starts the buffers are bound at.

#version 450 core

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer Source {
    uint source[];
};
layout(std430, set = 0, binding = 1) writeonly buffer Destination {
    uint destination[];
};

layout(push_constant) uniform Params {
    uint source_offset;
    uint destination_offset;
    uint pattern;
    uint count;
    uint groups_x;
};

void main() {
    const uint i = (gl_WorkGroupID.y * groups_x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
    if (i >= count) {
        return;
    }
    destination[destination_offset + i] = source[source_offset + i % pattern];
}
